{
  "name": "sankatsathi",
  "version": "1.0.0",
  "private": true,
  "description": "A WebMCP interface to Nepal's public disaster record.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "refdata": "node scripts/build-refdata.mjs",
    "snapshot": "node scripts/build-snapshot.mjs",
    "serve": "npx http-server public -p 8787 -c-1",
    "test:dash": "node scripts/dash-test.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "deploy": "npx wrangler pages deploy ./public --project-name sankatsathi",
    "deploy:proxy": "npx wrangler deploy worker.js --name sankatsathi-proxy"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
